#\!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔄 Syncing Gemini Extension commands..."
npm run build:commands
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
  echo "❌ Command sync failed. Check SKILL.md files and retry."
  exit 1
fi
git add commands/infinite-worlds-architect/*.toml

echo "🧪 Running pre-commit tests (ALL tests via Jest)..."

# Run ALL tests via npm test (which uses Jest exclusively)
timeout 60 npm test
TEST_EXIT=$?

if [ $TEST_EXIT -eq 124 ]; then
  echo "❌ Tests timed out (>60s). Investigate slow tests and retry."
  exit 1
elif [ $TEST_EXIT -ne 0 ]; then
  echo "❌ Tests failed. Fix failures and retry commit."
  exit 1
fi

echo "✅ All tests passed."
exit 0
