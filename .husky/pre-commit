#\!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🧪 Running pre-commit tests..."

# Check if changes are documentation-only
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null)
IS_DOC_ONLY=$(echo "$STAGED_FILES" | grep -v '\.(js|jsx|ts|tsx|cjs|mjs)$' | wc -l)
TOTAL_FILES=$(echo "$STAGED_FILES" | wc -l)

if [ "$IS_DOC_ONLY" -eq "$TOTAL_FILES" ] && [ "$TOTAL_FILES" -gt 0 ]; then
  echo "📝 Documentation-only changes detected. Skipping tests."
  exit 0
fi

# Use lint-staged to run tests only on staged changes (with timeout)
LINT_OUTPUT=$(mktemp)
timeout 30 npx lint-staged > "$LINT_OUTPUT" 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -eq 124 ]; then
  echo "⏱️  Tests timed out (>30s). Retry the commit or investigate slow tests."
  rm -f "$LINT_OUTPUT"
  exit 1
elif [ $EXIT_CODE -eq 0 ]; then
  echo "✅ All tests passed. Proceeding with commit."
  rm -f "$LINT_OUTPUT"
  exit 0
fi

# npm lint-staged failed. Check if it's an npm issue vs actual test failure
if grep -q "EROFS\|read-only.*file.*system\|npm error" "$LINT_OUTPUT" 2>/dev/null; then
  echo "⚠️  npm cache issue detected. Falling back to direct test execution..."

  # Create temp directory for tests
  TEMP_DIR=$(mktemp -d)
  TMP="$TEMP_DIR" TMPDIR="$TEMP_DIR" TEMP="$TEMP_DIR" timeout 30 node --test test/**/*.test.js > "$LINT_OUTPUT" 2>&1
  DIRECT_EXIT=$?

  rm -rf "$TEMP_DIR" "$LINT_OUTPUT"

  if [ $DIRECT_EXIT -eq 0 ]; then
    echo "✅ Tests passed via direct execution. Proceeding with commit."
    exit 0
  elif [ $DIRECT_EXIT -eq 124 ]; then
    echo "⏱️  Tests timed out (>30s). Retry the commit or investigate slow tests."
    exit 1
  else
    echo "❌ Tests failed. Commit aborted."
    exit 1
  fi
else
  # npm issue wasn't about cache/environment, it's actual test failure
  echo "❌ Tests failed. Commit aborted."
  cat "$LINT_OUTPUT"
  rm -f "$LINT_OUTPUT"
  exit 1
fi
